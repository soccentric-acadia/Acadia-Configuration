# webconfigd.service — hardened, non-root (spec §4.8).
#
# Listens on :8443 (TLS). The UI port is always reachable regardless of the
# service-based firewall (the firewall applier never blocks it).

[Unit]
Description=SoCcentric on-device WebConfig daemon
After=network.target systemd-networkd.service
Wants=network.target
# T-P01: the daemon's mutable state (data_dir = /pst/webconfig when /pst is
# present — config store, web-UI users, HQ pairing credential, TLS identity)
# lives on the persistent /pst partition. Order after its mount unit; on
# devices without the partition pst.mount is condition-skipped and this
# dependency falls through to the root mount (same pattern as
# instr-istate.service).
RequiresMountsFor=/pst

[Service]
Type=simple
User=webconfig
Group=webconfig
# T-P04 (G03/P-J01): journalctl reads (per-service journal, Logs page) need
# the systemd-journal group; the group always exists in the image.
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/default/webconfigd
ExecStart=/usr/bin/webconfigd

# --- Hardening (spec §4.8) ---------------------------------------------------
# Read-only root + /usr; the daemon may only write its data partition.
# T-P01: that partition is /pst/webconfig (persistent across OTA). The '-'
# prefix ignores the path on deployments without the /pst partition, where
# the daemon falls back to the (non-persistent) /data/webconfig default.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/pst/webconfig
# Update-bundle staging on the rootfs (/pst is too small for .swu bundles).
ReadWritePaths=-/var/lib/webconfig-ota
# No new privileges; no executing setuid binaries.
NoNewPrivileges=true
# Drop all capabilities except the ones genuinely needed (none for v1: the
# daemon uses D-Bus/polkit for privileged actions, not raw capabilities).
CapabilityBoundingSet=
AmbientCapabilities=
# Filesystem namespacing: deny device access and kernel modules.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# Network: the daemon must listen, so we cannot use PrivateNetwork.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Restrict syscalls to a sane set; deny ptrace/process meddling.
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
# Resource limits (spec §2: <15 MB RAM). The kernel enforces a ceiling.
MemoryMax=32M
# Restart policy.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target