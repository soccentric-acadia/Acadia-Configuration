// polkit rules for webconfigd (spec §3: privileged ops via D-Bus + polkit).
//
// Two privileged paths exist since T-P02:
//   1. the zbus service-control path (Services page start/stop/restart) —
//      these rules authorize it, unit-by-unit;
//   2. the webconfig-applyd root helper, which runs the appliers' systemctl /
//      hostnamectl / nft / … calls as root over the fixed-verb UDS — no
//      polkit involved (the helper's own allowlist is the boundary).
//
// The allowlist below therefore mirrors webconfig-applyd's SYSTEMCTL_*
// tables EXACTLY — update both together (T-P02). It is NOT blanket Manager
// access: only the verbs and units the appliers actually use.

polkit.addRule(function(action, subject) {
    // Only the webconfig system user may exercise these actions.
    if (subject.user !== "webconfig") {
        return polkit.Result.NOT_HANDLED;
    }

    // Reboot/poweroff (systemd-logind).
    if (action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.power-off") {
        return polkit.Result.YES;
    }

    // systemd Manager unit operations on the curated allowlist only.
    var managed = action.id === "org.freedesktop.systemd1.manage-units";
    if (managed) {
        var unit = action.lookup("unit");
        // Fixed units the appliers and the Services page drive
        // (webconfig-applyd allow::SYSTEMCTL_FIXED_UNITS).
        var allowed = [
            "sshd.service",
            "systemd-networkd.service",
            "systemd-resolved.service",
            "systemd-timesyncd.service",
            "systemd-journald.service",
            "wpa_supplicant.service",
            "hostapd.service",
            "dnsmasq.service",
            "phc2sys.service",
            "gpsd.service",
            "chrony.service",
            "chronyd.service",
            "webconfig-syslog-forward.service",
            "webconfigd.service",
            "swupdate.service",
            "swupdate.socket"
        ];
        // Dynamic per-device units the appliers generate
        // (webconfig-applyd allow::SYSTEMCTL_DYNAMIC_PREFIXES): can-<n>,
        // webconfig-serial-<dev>, webconfig-gpio-<n>, serial-getty@<tty>,
        // ptp4l@<if>.
        var dynamic = [
            "can-", "webconfig-serial-", "webconfig-gpio-",
            "serial-getty@", "ptp4l@"
        ];
        var i, ok = allowed.indexOf(unit) >= 0;
        for (i = 0; !ok && i < dynamic.length; i++) {
            if (unit.indexOf(dynamic[i]) === 0) {
                ok = true;
            }
        }
        if (ok) {
            return polkit.Result.YES;
        }
    }

    return polkit.Result.NOT_HANDLED;
});