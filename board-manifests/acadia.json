{
  "platform": "acadia",
  "model": "raspberry-pi-5",
  "board_name": "Raspberry Pi 5 (Acadia)",
  "hardware_matrix_version": "1.0.0",
  "hardware_board_revision": "rpi5-cm5-bom-rev-c",
  "has_rtc": true,
  "has_tpm": false,
  "secure_boot": false,
  "service_allowlist": [
    "sshd.socket",
    "systemd-networkd.service",
    "systemd-resolved.service",
    "wpa_supplicant.service",
    "chronyd.service",
    "rsyslog.service",
    "watchdog.service",
    "swupdate.service",
    "acadia-client.service",
    "instr-istate.service",
    "instr-alarms.service",
    "instr-backup.service",
    "instr-faults.service",
    "instr-hardware.service",
    "instr-logmanager.service",
    "instr-monitord.service",
    "instr-networkd.service",
    "instr-telemetry.service"
  ],
  "peripherals": [
    {
      "id": "ttyAMA0",
      "device": "/dev/ttyAMA0",
      "human_name": "RS-485 / RS-232 (GPIO14/15, RP1 UART0)",
      "kind": "serial",
      "caps": {
        "modes": [
          "rs232",
          "rs485"
        ],
        "owner": "hal_rs485"
      }
    },
    {
      "id": "ttyAMA2",
      "device": "/dev/ttyAMA2",
      "human_name": "Pico W co-processor link (RP1 UART2, GPIO0/1)",
      "kind": "serial",
      "caps": {
        "modes": [
          "rs232"
        ],
        "owner": "pico_link",
        "hil_verify": "uart2 overlay device node"
      }
    },
    {
      "id": "mcu-pico",
      "device": "/dev/ttyAMA2",
      "human_name": "Pico W co-processor link (RP1 UART2, GPIO0/1)",
      "kind": "mcu",
      "caps": {
        "protocol": "soccentric-mcu",
        "signed_fw": true,
        "settings_schema": "app:mcu-stm32",
        "firmware_pubkey_ed25519": "d04ab232742bb4ab3a1368bd4615e4e6d0224ab71a016baf8520a332c9778737",
        "flash_command": "/usr/local/bin/pico-flash",
        "hil_verify": "uart2 overlay device node"
      }
    },
    {
      "id": "can0",
      "device": "can0",
      "human_name": "CAN channel 0 (SPI HAT)",
      "kind": "can",
      "caps": {
        "fd": false
      }
    }
  ],
  "wifi_radio": {
    "interface": "wlan0",
    "hw_mode": "g",
    "channel": 7
  },
  "dashboard_tiles": [
    {
      "id": "cpu",
      "title": "CPU utilization",
      "metrics": [
        "cpu.util"
      ],
      "render": "sparkline"
    },
    {
      "id": "thermal",
      "title": "Thermal / throttle",
      "metrics": [
        "thermal.temp",
        "temp.throttled"
      ],
      "render": "state"
    },
    {
      "id": "mcu",
      "title": "Pico W heartbeat",
      "metrics": [
        "mcu.heartbeat",
        "mcu.fw_version"
      ],
      "render": "state"
    },
    {
      "id": "clock",
      "title": "Clock frequency",
      "metrics": [
        "cpu.freq"
      ],
      "render": "value"
    }
  ],
  "default_alert_rules": [
    {
      "id": "disk-full",
      "enabled": true,
      "metric": "disk.pct",
      "comparison": ">",
      "threshold": 90,
      "duration_secs": 60,
      "actions": [
        "ui"
      ]
    },
    {
      "id": "watchdog-reset",
      "enabled": true,
      "metric": "boot.watchdog",
      "comparison": ">",
      "threshold": 0,
      "duration_secs": 0,
      "actions": [
        "ui"
      ]
    },
    {
      "id": "throttling",
      "enabled": true,
      "metric": "temp.throttled",
      "comparison": ">",
      "threshold": 0,
      "duration_secs": 30,
      "actions": [
        "ui"
      ]
    },
    {
      "id": "cert-expiry",
      "enabled": true,
      "metric": "cert.*",
      "comparison": "<",
      "threshold": 30,
      "duration_secs": 0,
      "actions": [
        "ui"
      ]
    }
  ],
  "deferred_features": [
    "ptp",
    "ap_mode",
    "wireguard",
    "cellular"
  ],
  "meta": {
    "uart_allocation_authority": "Acadia-Hardware doc/uart-allocation.md (pin-map rev-c, T-P15)"
  }
}
